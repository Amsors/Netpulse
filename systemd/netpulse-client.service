[Unit]
Description=Netpulse TCP and UDP probe client with Prometheus exporter
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=netpulse
Group=netpulse
WorkingDirectory=/opt/netpulse
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m netpulse.client /etc/netpulse/client.toml
Restart=on-failure
RestartSec=3s
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077

[Install]
WantedBy=multi-user.target
